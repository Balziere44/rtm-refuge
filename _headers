# Cloudflare Pages / Netlify header rules.
# Note: Pages MERGES every matching block instead of letting the most specific
# one win, so no path may be covered by two blocks that both set Cache-Control.

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Artwork and icons. The names are never reused, so these can be cached hard.
/assets/img/*
  Cache-Control: public, max-age=31536000, immutable

# Monster sprites: 718 files keyed by monster id, so a name never changes
# meaning. The database paints sixty rows at a time and each one wants an
# image, which is only bearable if the second visit asks for none of them.
/assets/sprites/*
  Cache-Control: public, max-age=31536000, immutable

# The share card is replaced under the same filename whenever the branding
# changes, so it must revalidate or chat clients keep showing the old one.
# This is exactly why it does not live under /assets/img/.
/assets/social/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/css/*
  Cache-Control: public, max-age=3600, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=3600, must-revalidate

# The database payload is 1.7 MB and is regenerated only when the game data
# changes, so it revalidates daily rather than on every visit.
/assets/data/*
  Cache-Control: public, max-age=86400, must-revalidate
